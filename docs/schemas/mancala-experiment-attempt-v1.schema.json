{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mancala.ai/schemas/mancala-experiment-attempt-v1.schema.json",
  "title": "Mancala AI experiment attempt freeze",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "experiment_id",
    "attempt_id",
    "experiment_type",
    "hypothesis",
    "objective",
    "source_commit",
    "execution_source_identity",
    "worktree_path",
    "base_commit",
    "input_artifacts",
    "checkpoint_identity",
    "runtime_versions",
    "command",
    "environment",
    "configuration",
    "random_seeds",
    "device",
    "worker_count",
    "resource_budget",
    "acceptance_criteria",
    "output_paths",
    "publication_outputs",
    "status",
    "frozen_at"
  ],
  "properties": {
    "schema": {"const": "mancala-experiment-attempt-v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "experiment_type": {"type": "string", "minLength": 1},
    "authorization_reference": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "registration_path": {"type": "string", "minLength": 1},
    "registration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hypothesis": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "execution_source_identity": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "worktree_path": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "input_artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "checkpoint_identity": {"type": ["object", "null"]},
    "runtime_versions": {"type": "object"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "configuration": {"type": "object"},
    "random_seeds": {"type": "array", "items": {"type": "integer"}},
    "device": {"type": "object"},
    "worker_count": {"type": "integer", "minimum": 1},
    "resource_budget": {
      "type": "object",
      "required": ["expected_runtime_seconds", "wall_time_limit_seconds", "minimum_free_disk_bytes", "additional_limits"],
      "properties": {
        "expected_runtime_seconds": {"type": "integer", "minimum": 0},
        "wall_time_limit_seconds": {"type": "integer", "minimum": 0},
        "minimum_free_disk_bytes": {"type": "integer", "minimum": 0},
        "additional_limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "publication_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"const": "frozen"},
    "frozen_at": {"type": "string", "format": "date-time"}
  }
}
