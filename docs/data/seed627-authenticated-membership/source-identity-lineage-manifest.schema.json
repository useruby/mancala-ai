{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed 627 source identity and lineage manifest",
  "type": "object",
  "required": [
    "schema", "status", "historical_evidence_modified", "runtime", "dependency_identity",
    "raw_input_sha256", "source_verifier_results", "snapshot_counts",
    "snapshot_sha256", "snapshot_file_sha256", "training_lineage", "verification", "provenance",
    "snapshot_schema"
  ],
  "properties": {
    "schema": {"const": "seed627-source-identity-lineage-manifest-v1"},
    "status": {"enum": ["authenticated", "blocked"]},
    "historical_evidence_modified": {"const": false},
    "runtime": {"type": "object"},
    "dependency_identity": {"type": "object", "required": ["runtime_lock", "runtime_lock_sha256", "source_sha256"]},
    "raw_input_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "source_verifier_results": {"type": "object"},
    "snapshot_counts": {"type": "object", "required": ["B512", "S615", "protected_holdout"]},
    "snapshot_sha256": {"type": "object", "required": ["B512", "S615", "protected_holdout"], "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "snapshot_file_sha256": {"type": "object", "required": ["B512", "S615", "protected_holdout"], "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "training_lineage": {"type": "object", "required": ["B512", "S615"]},
    "verification": {"type": "object"},
    "provenance": {"type": "object"},
    "snapshot_schema": {"const": "seed627-authenticated-membership-snapshot-v1"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
